# ── Genesis Environment Configuration (DEFAULT) ──────────────────────
# SCHEMA REFERENCE. Every key here maps to a field in bot/config/settings.py.
#
# First-time setup:
#     copy .env.example .env       (Windows)
#     cp   .env.example .env       (macOS / Linux)
# Then fill MT5_LOGIN, MT5_PASSWORD, MT5_SERVER (and DISCORD_* if you want
# Discord integration). Run `python scripts/check_setup.py` BEFORE
# `python main.py` to validate everything is in place.
#
# ── Profiles ──────────────────────────────────────────────────────────
# Set GENESIS_PROFILE to one of: scalper, breakout, daytrader
# Each loads a dedicated .env file with profile-optimized settings:
#   GENESIS_PROFILE=scalper    → loads `.env.scalper`    (M1 RSI cross scalping)
#   GENESIS_PROFILE=breakout   → loads `.env.breakout`   (London/NY session opens)
#   GENESIS_PROFILE=daytrader  → loads `.env.daytrader`  (3-strategy session matrix)
# Unset / default → loads `.env` (standard H4→H1→M15 profile)
# Falls back to .env if the profile-specific file is missing.

# ── Profile ────────────────────────────────────────────────────────
# Read-only at runtime; usually set via GENESIS_PROFILE env var, not here.
ACTIVE_PROFILE=default

# ── MT5 Connection ────────────────────────────────────────────────
# Genesis is locked to a single MetaQuotes-Demo account. All profiles
# (default, scalper, breakout, daytrader) trade on the SAME account.
# Profile switching ONLY changes strategy logic — not the MT5 login.
# Windows installs MT5 under C:\Program Files\MetaTrader 5 by default.
# macOS / Linux users: set MT5_PATH explicitly (Wine / Parallels / VPS).
MT5_LOGIN=5052013100
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── Trading Pairs ──────────────────────────────────────────────────
# JSON-style list. Broker-specific suffixes are appended automatically
# when present (e.g. EURUSD.raw vs EURUSD).
TRADING_PAIRS=["EURUSD","GBPUSD","USDJPY","USDCHF","AUDUSD","USDCAD","NZDUSD","EURGBP","EURJPY","EURCHF","EURAUD","EURCAD","GBPJPY","GBPCHF","GBPAUD","GBPCAD","AUDJPY","CADJPY","CHFJPY","AUDCAD"]

# ── Trading Mode ──────────────────────────────────────────────────
# paper_trading=true  → demo account only, no live orders.
# paper_trading=false → LIVE MONEY. Real broker creds required.
PAPER_TRADING=true
STARTING_CAPITAL=1000.0

# ── Risk Management ───────────────────────────────────────────────
# Per-trade risk as a fraction of equity: 0.01 = 1%.
MAX_RISK_PER_TRADE=0.01
# Daily drawdown circuit breaker: 0.05 = 5% equity drop in a day stops NEW
# entries; orchestrator also auto-flattens when tripped (kill switch).
MAX_DAILY_DRAWDOWN=0.05
MAX_OPEN_POSITIONS=3
MIN_REWARD_RATIO=2.0
# Pause trading for LOSING_STREAK_COOLDOWN seconds after N consecutive losses.
LOSING_STREAK_PAUSE=3
LOSING_STREAK_COOLDOWN=3600

# ── Strategy: Trend Filter ─────────────────────────────────────────
EMA_PERIOD=200
ADX_PERIOD=14
# ADX > TREND threshold → TRENDING regime.
ADX_TREND_THRESHOLD=25.0
# ADX < RANGE threshold → RANGING regime.
ADX_RANGE_THRESHOLD=20.0

# ── Strategy: RSI Filter ──────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

# ── Strategy: ATR Stops ───────────────────────────────────────────
# SL = entry ± ATR * SL_MULTIPLIER.  TP = entry ± ATR * TP_MULTIPLIER.
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
# Regime is classified VOLATILE if ATR exceeds running average by this factor.
ATR_VOLATILITY_SPIKE=2.0

# ── Strategy: Timeframes ──────────────────────────────────────────
# Higher TF = trend filter. Entry TF = signal search.
HIGHER_TIMEFRAME=H4
ENTRY_TIMEFRAME=M15

# ── Rule 1: Gatekeeper Trend Guard (H1 ADX/EMA Filter) ────────────
# Blocks SELL signals when H1 ADX > 25 AND Price > 50 EMA (strong uptrend).
# Set GATEKEEPER_ADX_THRESHOLD to 0 to disable.
GATEKEEPER_TIMEFRAME=H1
GATEKEEPER_ADX_THRESHOLD=25.0
GATEKEEPER_EMA_PERIOD=50

# ── Rule 2: Minimum SL Floor (H1 ATR) ─────────────────────────────
# Enforces a minimum stop-loss distance = H1 ATR × this multiplier.
# If a strategy calculates SL = 6.5 pips but H1 ATR = 14 pips, the SL
# is bumped to 14 pips.  Set to 0 to disable.
MIN_SL_H1_ATR_MULT=1.0

# ── Rule 3: M15 Sniper Confirmation ───────────────────────────────
# Before entry, requires the latest M15 candle to confirm momentum:
#   SELL: lower high + bearish close
#   BUY:  higher low + bullish close
# Set to false to disable.
SNIPER_CONFIRMATION_ENABLED=true

# ── Rule 4: Spread-Aware Breakeven Logic ──────────────────────────
# Auto-moves SL to breakeven (with spread buffer) once profit reaches
# BREAKEVEN_ACTIVATION_ATR×ATR.  Prevents accidental stop-outs from
# the Bid/Ask gap — critical for SELL trades where SL triggers on Ask.
BREAKEVEN_ENABLED=true
BREAKEVEN_ACTIVATION_ATR=1.0
BREAKEVEN_SPREAD_BUFFER_MULT=2.0
# Progressive buffer: as profit increases, the spread buffer tightens
# from BREAKEVEN_SPREAD_BUFFER_MULT down to this minimum value over a
# window of 2× BREAKEVEN_ACTIVATION_ATR.  Default 0.5 means at 3+×ATR
# in profit the buffer is only 0.5× the current spread (tight but safe).
BREAKEVEN_PROGRESSIVE_BUFFER_MIN=0.5

# ── News Filter ───────────────────────────────────────────────────
# Pauses entries around high-impact economic events.
NEWS_FILTER_ENABLED=true
NEWS_BUFFER_MINUTES_BEFORE=30
NEWS_BUFFER_MINUTES_AFTER=30
NEWS_CALENDAR_REFRESH_INTERVAL=3600

# ── Self-Optimization ─────────────────────────────────────────────
# Rolling window size for performance metrics.
PERFORMANCE_WINDOW=20
# Auto-pause thresholds; not strict kill switches, just a guard.
MIN_WIN_RATE=0.40
MIN_AVG_RR=1.0
# Minimum signal confidence (0.0-1.0) for an entry. Lower = more trades.
MIN_CONFIDENCE=0.40

# ── Position Sizing ───────────────────────────────────────────────
# Scale position size inversely with volatility when true.
VOLATILITY_POSITION_SCALE=true

# ── Notifications ─────────────────────────────────────────────────
# Empty DISCORD_TOKEN OR zero DISCORD_CHANNEL_ID disables Discord cleanly.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=0
DISCORD_COMMAND_PREFIX=!

# ── Dashboard ─────────────────────────────────────────────────────
# 0.0.0.0 binds on all interfaces (LAN-accessible). Use 127.0.0.1 for
# localhost-only. The dashboard URL is printed at startup regardless.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///database/trades.db

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ── General ───────────────────────────────────────────────────────
BOT_NAME=Genesis Trading Bot
# MT5 magic number — single source of truth for all Genesis orders.
# WARNING: changing this on a live account disqualifies the bot from
# flat-positioning its own history.
MAGIC_NUMBER=202406
